{
  "name": "praise-star",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "연준이의 칭찬 별나라 — 가족 공동 칭찬과 확정·랜덤 보상",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.edge.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "python tests/experience_browser_test.py",
    "check:deploy": "node scripts/deployment.mjs",
    "test:db": "python3 tests/db_test.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
