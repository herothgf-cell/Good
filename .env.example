# Public frontend configuration only. Never use sb_secret_ or service_role here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_PUBLIC_KEY
# Legacy name SUPABASE_ANON_KEY remains supported.
# Optional: REQUIRE_CLOUD_CONFIG=1 makes a build fail instead of publishing demo mode.
